// ============================================================================
// SYNCHRONIX v3.0.0 — Foundation: Unified M:N Async & RTOS Fiber Scheduler
// (src/runtime/async_rt.synchronix)
// ============================================================================
// Pure Synchronix Unified Cooperative M:N & RTOS Fiber Scheduler:
//   - Hosted Mode (sx2_sched_init): 256-task capacity (Main V2 Parity)
//   - Embedded Mode (sx2_sched_init_embedded): 32-task bounded SRAM table
//     (1536 B, Embedded V2 Parity)
//   - Priority-aware cooperative dispatch (higher TASK_PRIO runs first)
//   - Deterministic tick counter & fiber telemetry
// ============================================================================

import sx_defs
import utils

phi async_rt_host_tasks = 256 > 0
phi async_rt_emb_tasks  = 32 > 0
phi async_rt_emb_sram   = (32 * 48) == 1536

func SCH_TABLE()     -> Int { return 0 }
func SCH_COUNT()     -> Int { return 1 }
func SCH_COMPLETED() -> Int { return 2 }
func SCH_YIELDS()    -> Int { return 3 }
func SCH_TICKS()     -> Int { return 4 }
func SCH_CAP()       -> Int { return 5 }
func SCH_MODE()      -> Int { return 6 }

func sx2_sched_init_mode(mode: Int) -> Int {
    let sch = sx_buf_new(8)
    var cap = MAX_TASKS()
    if mode == MEM_MODE_EMBEDDED() {
        cap = EMB_MAX_TASKS()
    }
    let tbl = sx_buf_new(cap * TASK_STRIDE())
    sx_buf_set(sch, SCH_TABLE(), tbl)
    sx_buf_set(sch, SCH_COUNT(), 0)
    sx_buf_set(sch, SCH_COMPLETED(), 0)
    sx_buf_set(sch, SCH_YIELDS(), 0)
    sx_buf_set(sch, SCH_TICKS(), 0)
    sx_buf_set(sch, SCH_CAP(), cap)
    sx_buf_set(sch, SCH_MODE(), mode)
    return sch
}

func sx2_sched_init() -> Int {
    return sx2_sched_init_mode(MEM_MODE_HOSTED())
}

func sx2_sched_init_embedded() -> Int {
    return sx2_sched_init_mode(MEM_MODE_EMBEDDED())
}

func sx2_spawn_prio(sch: Int, fn_id: Int, arg: Int, prio: Int) -> Int {
    let cnt = sx_buf_get(sch, SCH_COUNT())
    let cap = sx_buf_get(sch, SCH_CAP())
    if cnt >= cap {
        return 0
    }
    sx_buf_set(sch, SCH_COUNT(), cnt + 1)
    let tbl = sx_buf_get(sch, SCH_TABLE())
    let base = cnt * TASK_STRIDE()
    let tid = cnt + 1
    sx_buf_set(tbl, base + TASK_ID(), tid)
    sx_buf_set(tbl, base + TASK_STATE(), TASK_READY())
    sx_buf_set(tbl, base + TASK_FN(), fn_id)
    sx_buf_set(tbl, base + TASK_ARG(), arg)
    sx_buf_set(tbl, base + TASK_RESULT(), 0)
    sx_buf_set(tbl, base + TASK_PRIO(), prio)
    return tid
}

func sx2_spawn(sch: Int, fn_id: Int, arg: Int) -> Int {
    let tid = sx2_spawn_prio(sch, fn_id, arg, 1)
    return tid
}

func sx2_sched_tick(sch: Int) -> Int {
    let t = sx_buf_get(sch, SCH_TICKS()) + 1
    sx_buf_set(sch, SCH_TICKS(), t)
    return t
}

func sx2_fiber_dispatch(fn_id: Int, arg: Int) -> Int {
    if fn_id == 1 {
        return arg * arg + 10
    }
    if fn_id == 2 {
        return arg * 2 + 1
    }
    if fn_id == 3 {
        // Sensor filter kernel: smooth Q16 sample
        return (arg * 3 + 100) / 4
    }
    return arg
}

func sx2_sched_run_one(sch: Int) -> Int {
    let cnt = sx_buf_get(sch, SCH_COUNT())
    let tbl = sx_buf_get(sch, SCH_TABLE())
    var best_i = -1
    var best_p = -1
    var i = 0
    while i < cnt {
        let base = i * TASK_STRIDE()
        let st = sx_buf_get(tbl, base + TASK_STATE())
        if st == TASK_READY() {
            let pr = sx_buf_get(tbl, base + TASK_PRIO())
            if pr > best_p {
                best_p = pr
                best_i = i
            }
        }
        i = i + 1
    }
    if best_i < 0 {
        return 0
    }

    let b = best_i * TASK_STRIDE()
    sx_buf_set(tbl, b + TASK_STATE(), TASK_RUNNING())
    let fn_id = sx_buf_get(tbl, b + TASK_FN())
    let arg = sx_buf_get(tbl, b + TASK_ARG())
    let res = sx2_fiber_dispatch(fn_id, arg)
    sx_buf_set(tbl, b + TASK_RESULT(), res)
    sx_buf_set(tbl, b + TASK_STATE(), TASK_DONE())
    let comp = sx_buf_get(sch, SCH_COMPLETED())
    sx_buf_set(sch, SCH_COMPLETED(), comp + 1)
    sx2_sched_tick(sch)
    return 1
}

func sx2_await(sch: Int, task_id: Int) -> Int
    requires task_id >= 1
{
    let idx = task_id - 1
    let tbl = sx_buf_get(sch, SCH_TABLE())
    let base = idx * TASK_STRIDE()
    var running = 1
    while running != 0 {
        let st = sx_buf_get(tbl, base + TASK_STATE())
        if st == TASK_DONE() {
            running = 0
        } else {
            let y = sx_buf_get(sch, SCH_YIELDS())
            sx_buf_set(sch, SCH_YIELDS(), y + 1)
            let ran = sx2_sched_run_one(sch)
            if ran == 0 {
                running = 0
            }
        }
    }
    let res = sx_buf_get(tbl, base + TASK_RESULT())
    return res
}

func sx2_sched_stats(sch: Int) -> Int {
    let sp = sx_buf_get(sch, SCH_COUNT())
    let cp = sx_buf_get(sch, SCH_COMPLETED())
    let yl = sx_buf_get(sch, SCH_YIELDS())
    let tk = sx_buf_get(sch, SCH_TICKS())
    let cap = sx_buf_get(sch, SCH_CAP())
    let mode = sx_buf_get(sch, SCH_MODE())
    if mode == MEM_MODE_EMBEDDED() {
        print("  RTOS Fibers : spawned="); print(sp); print("/"); print(cap)
    } else {
        print("  M:N Async   : spawned="); print(sp); print("/"); print(cap)
    }
    print(" completed="); print(cp)
    print(" yields="); print(yl)
    print(" ticks="); println(tk)
    return 0
}

// ============================================================================
// SYNCHRONIX v3.0.0 — Foundation: Unified Dual-Mode Memory Engine
// (src/runtime/memory_rt.synchronix)
// ============================================================================
// Pure Synchronix Unified Hosted + Embedded Memory Runtime:
//   Mode 0 (MEM_MODE_HOSTED — Main V2 Parity):
//     - 64 KB Bump-Pointer Arena Allocator (8192 words) with heap fallback
//     - Dynamic Swift-inspired ARC Engine (deterministic free on rc == 0)
//     - Dynamic Kotlin-inspired Tracing Mark-and-Sweep GC (1024 shadow roots)
//   Mode 1 (MEM_MODE_EMBEDDED — Embedded V2 Parity, Zero Heap Churn):
//     - Bounded 4096 B Static Bump-Pointer Arena (no heap fallback)
//     - 64-slot Pre-Allocated Static ARC Slab Pool (O(1) deterministic reuse)
//     - 64-slot Bounded-Pause Tracing Mark-and-Sweep GC (64 shadow roots)
//     - Peak Watermark & OOM Telemetry for Embedded SRAM Budgeting
// ============================================================================

import sx_defs
import utils

phi mem_rt_host_arena_bytes = (8192 * 8) == 65536
phi mem_rt_emb_arena_bytes  = (512 * 8) == 4096
phi mem_rt_arc_pool_bytes   = (64 * 48) == 3072
phi mem_rt_gc_pool_bytes    = (64 * 48) == 3072
phi mem_rt_obj_slots        = 6 == 6

// Unified Memory Runtime State Layout (slots in rt_mem handle)
func MRT_ARENA_BUF()   -> Int { return 0 }
func MRT_ARENA_POS()   -> Int { return 1 }
func MRT_ARC_ALLOCS()  -> Int { return 2 }
func MRT_ARC_RETAINS() -> Int { return 3 }
func MRT_ARC_RELS()    -> Int { return 4 }
func MRT_ARC_FREED()   -> Int { return 5 }
func MRT_ARC_LIVE()    -> Int { return 6 }
func MRT_GC_HEAD()     -> Int { return 7 }
func MRT_GC_ROOTS()    -> Int { return 8 }
func MRT_GC_RTOP()     -> Int { return 9 }
func MRT_GC_ALLOCS()   -> Int { return 10 }
func MRT_GC_CYCLES()   -> Int { return 11 }
func MRT_GC_SWEPT()    -> Int { return 12 }
func MRT_GC_LIVE()     -> Int { return 13 }
func MRT_ARC_POOL()    -> Int { return 14 }
func MRT_GC_POOL()     -> Int { return 15 }
func MRT_ARC_PEAK()    -> Int { return 16 }
func MRT_GC_PEAK()     -> Int { return 17 }
func MRT_OOM_COUNT()   -> Int { return 18 }
func MRT_MODE()        -> Int { return 19 }
func MRT_ARENA_CAP()   -> Int { return 20 }
func MRT_ROOT_CAP()    -> Int { return 21 }

func sx2_mem_init_mode(mode: Int) -> Int {
    let rt = sx_buf_new(24)
    sx_buf_set(rt, MRT_MODE(), mode)
    sx_buf_set(rt, MRT_ARENA_POS(), 0)
    sx_buf_set(rt, MRT_GC_HEAD(), 0)
    sx_buf_set(rt, MRT_GC_RTOP(), 0)
    sx_buf_set(rt, MRT_ARC_PEAK(), 0)
    sx_buf_set(rt, MRT_GC_PEAK(), 0)
    sx_buf_set(rt, MRT_OOM_COUNT(), 0)

    if mode == MEM_MODE_EMBEDDED() {
        let arena = sx_buf_new(EMB_ARENA_WORDS())
        let roots = sx_buf_new(EMB_MAX_GC_ROOTS())
        let arc_pool = sx_buf_new(EMB_ARC_POOL_CAP())
        let gc_pool = sx_buf_new(EMB_GC_POOL_CAP())

        var i = 0
        while i < EMB_ARC_POOL_CAP() {
            let slot = sx_buf_new(OBJ_STRIDE())
            sx_buf_set(slot, OBJ_MAGIC(), 0)
            sx_buf_set(slot, OBJ_FLAGS(), OBJF_FREE())
            sx_buf_set(arc_pool, i, slot)
            i = i + 1
        }
        var j = 0
        while j < EMB_GC_POOL_CAP() {
            let gslot = sx_buf_new(OBJ_STRIDE())
            sx_buf_set(gslot, OBJ_MAGIC(), 0)
            sx_buf_set(gslot, OBJ_FLAGS(), OBJF_FREE())
            sx_buf_set(gc_pool, j, gslot)
            j = j + 1
        }

        sx_buf_set(rt, MRT_ARENA_BUF(), arena)
        sx_buf_set(rt, MRT_ARENA_CAP(), EMB_ARENA_WORDS())
        sx_buf_set(rt, MRT_GC_ROOTS(), roots)
        sx_buf_set(rt, MRT_ROOT_CAP(), EMB_MAX_GC_ROOTS())
        sx_buf_set(rt, MRT_ARC_POOL(), arc_pool)
        sx_buf_set(rt, MRT_GC_POOL(), gc_pool)
        return rt
    }

    // Hosted Dynamic Profile (Main V2 Parity)
    let h_arena = sx_buf_new(HOST_ARENA_WORDS())
    let h_roots = sx_buf_new(MAX_GC_ROOTS())
    sx_buf_set(rt, MRT_ARENA_BUF(), h_arena)
    sx_buf_set(rt, MRT_ARENA_CAP(), HOST_ARENA_WORDS())
    sx_buf_set(rt, MRT_GC_ROOTS(), h_roots)
    sx_buf_set(rt, MRT_ROOT_CAP(), MAX_GC_ROOTS())
    sx_buf_set(rt, MRT_ARC_POOL(), 0)
    sx_buf_set(rt, MRT_GC_POOL(), 0)
    return rt
}

func sx2_mem_init() -> Int {
    return sx2_mem_init_mode(MEM_MODE_HOSTED())
}

func sx2_mem_init_embedded() -> Int {
    return sx2_mem_init_mode(MEM_MODE_EMBEDDED())
}

// ----------------------------------------------------------------------------
// 1. Dual-Mode Bump-Pointer Arena Allocator (Hosted Fallback / Embedded Bounded)
// ----------------------------------------------------------------------------
func sx2_arena_alloc(rt: Int, words: Int) -> Int
    requires words > 0
{
    let pos = sx_buf_get(rt, MRT_ARENA_POS())
    let cap = sx_buf_get(rt, MRT_ARENA_CAP())
    if pos + words <= cap {
        sx_buf_set(rt, MRT_ARENA_POS(), pos + words)
        return pos
    }
    let mode = sx_buf_get(rt, MRT_MODE())
    if mode == MEM_MODE_EMBEDDED() {
        let oom = sx_buf_get(rt, MRT_OOM_COUNT())
        sx_buf_set(rt, MRT_OOM_COUNT(), oom + 1)
        return -1
    }
    let fallback = sx_buf_new(words)
    return fallback
}

func sx2_arena_reset(rt: Int) -> Int {
    sx_buf_set(rt, MRT_ARENA_POS(), 0)
    return 0
}

// ----------------------------------------------------------------------------
// 2. Dual-Mode Swift-Inspired Deterministic ARC Engine
// ----------------------------------------------------------------------------
func sx2_arc_alloc(rt: Int, payload_words: Int) -> Int
    requires payload_words > 0
{
    let mode = sx_buf_get(rt, MRT_MODE())
    var chosen = 0

    if mode == MEM_MODE_EMBEDDED() {
        let pool = sx_buf_get(rt, MRT_ARC_POOL())
        var i = 0
        while i < EMB_ARC_POOL_CAP() && chosen == 0 {
            let cand = sx_buf_get(pool, i)
            let fl = sx_buf_get(cand, OBJ_FLAGS())
            if (fl && OBJF_FREE()) != 0 {
                chosen = cand
            }
            i = i + 1
        }
        if chosen == 0 {
            let oom = sx_buf_get(rt, MRT_OOM_COUNT())
            sx_buf_set(rt, MRT_OOM_COUNT(), oom + 1)
            return 0
        }
    } else {
        chosen = sx_buf_new(OBJ_STRIDE() + payload_words - 1)
    }

    sx_buf_set(chosen, OBJ_MAGIC(), SX_MAGIC_ARC())
    sx_buf_set(chosen, OBJ_FLAGS(), OBJF_ARC())
    sx_buf_set(chosen, OBJ_RC(), 1)
    sx_buf_set(chosen, OBJ_SIZE(), payload_words * 8)
    sx_buf_set(chosen, OBJ_NEXT(), 0)
    sx_buf_set(chosen, OBJ_VAL(), 0)

    let a = sx_buf_get(rt, MRT_ARC_ALLOCS())
    let l = sx_buf_get(rt, MRT_ARC_LIVE()) + 1
    sx_buf_set(rt, MRT_ARC_ALLOCS(), a + 1)
    sx_buf_set(rt, MRT_ARC_LIVE(), l)
    let pk = sx_buf_get(rt, MRT_ARC_PEAK())
    if l > pk {
        sx_buf_set(rt, MRT_ARC_PEAK(), l)
    }
    return chosen
}

func sx2_arc_box_int(rt: Int, value: Int) -> Int {
    let obj = sx2_arc_alloc(rt, 1)
    if obj != 0 {
        sx_buf_set(obj, OBJ_VAL(), value)
    }
    return obj
}

func sx2_arc_unbox_int(obj: Int) -> Int {
    if obj == 0 { return 0 }
    let v = sx_buf_get(obj, OBJ_VAL())
    return v
}

func sx2_arc_retain(rt: Int, obj: Int) -> Int {
    if obj == 0 { return 0 }
    let magic = sx_buf_get(obj, OBJ_MAGIC())
    if magic != SX_MAGIC_ARC() { return obj }
    let rc = sx_buf_get(obj, OBJ_RC())
    sx_buf_set(obj, OBJ_RC(), rc + 1)
    let r = sx_buf_get(rt, MRT_ARC_RETAINS())
    sx_buf_set(rt, MRT_ARC_RETAINS(), r + 1)
    return obj
}

func sx2_arc_release(rt: Int, obj: Int) -> Int {
    if obj == 0 { return 0 }
    let magic = sx_buf_get(obj, OBJ_MAGIC())
    if magic != SX_MAGIC_ARC() { return 0 }

    let rels = sx_buf_get(rt, MRT_ARC_RELS())
    sx_buf_set(rt, MRT_ARC_RELS(), rels + 1)

    let rc = sx_buf_get(obj, OBJ_RC()) - 1
    sx_buf_set(obj, OBJ_RC(), rc)
    if rc > 0 {
        return rc
    }

    sx_buf_set(obj, OBJ_MAGIC(), 0)
    let live = sx_buf_get(rt, MRT_ARC_LIVE())
    let freed = sx_buf_get(rt, MRT_ARC_FREED())
    sx_buf_set(rt, MRT_ARC_LIVE(), live - 1)
    sx_buf_set(rt, MRT_ARC_FREED(), freed + 1)

    let mode = sx_buf_get(rt, MRT_MODE())
    if mode == MEM_MODE_EMBEDDED() {
        sx_buf_set(obj, OBJ_FLAGS(), OBJF_FREE())
        sx_buf_set(obj, OBJ_VAL(), 0)
    } else {
        sx_buf_free(obj)
    }
    return 0
}

// ----------------------------------------------------------------------------
// 3. Dual-Mode Tracing Mark-and-Sweep GC + Shadow Root Stack
// ----------------------------------------------------------------------------
func sx2_gc_box_int(rt: Int, value: Int) -> Int {
    let mode = sx_buf_get(rt, MRT_MODE())
    var chosen = 0

    if mode == MEM_MODE_EMBEDDED() {
        let pool = sx_buf_get(rt, MRT_GC_POOL())
        var i = 0
        while i < EMB_GC_POOL_CAP() && chosen == 0 {
            let cand = sx_buf_get(pool, i)
            let fl = sx_buf_get(cand, OBJ_FLAGS())
            if (fl && OBJF_FREE()) != 0 {
                chosen = cand
            }
            i = i + 1
        }
        if chosen == 0 {
            let oom = sx_buf_get(rt, MRT_OOM_COUNT())
            sx_buf_set(rt, MRT_OOM_COUNT(), oom + 1)
            return 0
        }
    } else {
        chosen = sx_buf_new(OBJ_STRIDE())
    }

    let head = sx_buf_get(rt, MRT_GC_HEAD())
    sx_buf_set(chosen, OBJ_MAGIC(), SX_MAGIC_GC())
    sx_buf_set(chosen, OBJ_FLAGS(), OBJF_GC())
    sx_buf_set(chosen, OBJ_RC(), 0)
    sx_buf_set(chosen, OBJ_SIZE(), 8)
    sx_buf_set(chosen, OBJ_NEXT(), head)
    sx_buf_set(chosen, OBJ_VAL(), value)
    sx_buf_set(rt, MRT_GC_HEAD(), chosen)

    let a = sx_buf_get(rt, MRT_GC_ALLOCS())
    let l = sx_buf_get(rt, MRT_GC_LIVE()) + 1
    sx_buf_set(rt, MRT_GC_ALLOCS(), a + 1)
    sx_buf_set(rt, MRT_GC_LIVE(), l)
    let pk = sx_buf_get(rt, MRT_GC_PEAK())
    if l > pk {
        sx_buf_set(rt, MRT_GC_PEAK(), l)
    }
    return chosen
}

func sx2_gc_unbox_int(obj: Int) -> Int {
    if obj == 0 { return 0 }
    let v = sx_buf_get(obj, OBJ_VAL())
    return v
}

func sx2_gc_push_root(rt: Int, obj: Int) -> Int {
    let top = sx_buf_get(rt, MRT_GC_RTOP())
    let rcap = sx_buf_get(rt, MRT_ROOT_CAP())
    if top < rcap {
        let roots = sx_buf_get(rt, MRT_GC_ROOTS())
        sx_buf_set(roots, top, obj)
        sx_buf_set(rt, MRT_GC_RTOP(), top + 1)
    }
    return top
}

func sx2_gc_pop_root(rt: Int) -> Int {
    let top = sx_buf_get(rt, MRT_GC_RTOP())
    if top > 0 {
        sx_buf_set(rt, MRT_GC_RTOP(), top - 1)
    }
    return 0
}

func sx2_gc_collect(rt: Int) -> Int {
    let cyc = sx_buf_get(rt, MRT_GC_CYCLES())
    sx_buf_set(rt, MRT_GC_CYCLES(), cyc + 1)

    // MARK PHASE
    let roots = sx_buf_get(rt, MRT_GC_ROOTS())
    let rtop = sx_buf_get(rt, MRT_GC_RTOP())
    var i = 0
    while i < rtop {
        let obj = sx_buf_get(roots, i)
        if obj != 0 {
            let m = sx_buf_get(obj, OBJ_MAGIC())
            if m == SX_MAGIC_GC() {
                let fl = sx_buf_get(obj, OBJ_FLAGS())
                let mfl = fl || OBJF_GC_MARKED()
                sx_buf_set(obj, OBJ_FLAGS(), mfl)
            }
        }
        i = i + 1
    }

    // SWEEP PHASE
    let mode = sx_buf_get(rt, MRT_MODE())
    var swept = 0
    var prev = 0
    var cur = sx_buf_get(rt, MRT_GC_HEAD())
    while cur != 0 {
        let nxt = sx_buf_get(cur, OBJ_NEXT())
        let fl = sx_buf_get(cur, OBJ_FLAGS())
        let marked = fl && OBJF_GC_MARKED()
        if marked != 0 {
            sx_buf_set(cur, OBJ_FLAGS(), OBJF_GC())
            prev = cur
        } else {
            if prev == 0 {
                sx_buf_set(rt, MRT_GC_HEAD(), nxt)
            } else {
                sx_buf_set(prev, OBJ_NEXT(), nxt)
            }
            sx_buf_set(cur, OBJ_MAGIC(), 0)
            if mode == MEM_MODE_EMBEDDED() {
                sx_buf_set(cur, OBJ_FLAGS(), OBJF_FREE())
                sx_buf_set(cur, OBJ_NEXT(), 0)
            } else {
                sx_buf_free(cur)
            }
            swept = swept + 1
            let live = sx_buf_get(rt, MRT_GC_LIVE())
            let sw_tot = sx_buf_get(rt, MRT_GC_SWEPT())
            sx_buf_set(rt, MRT_GC_LIVE(), live - 1)
            sx_buf_set(rt, MRT_GC_SWEPT(), sw_tot + 1)
        }
        cur = nxt
    }
    return swept
}

func sx2_mem_stats(rt: Int) -> Int {
    let mode = sx_buf_get(rt, MRT_MODE())
    let aa = sx_buf_get(rt, MRT_ARC_ALLOCS())
    let ar = sx_buf_get(rt, MRT_ARC_RETAINS())
    let al = sx_buf_get(rt, MRT_ARC_RELS())
    let af = sx_buf_get(rt, MRT_ARC_FREED())
    let av = sx_buf_get(rt, MRT_ARC_LIVE())
    let apk = sx_buf_get(rt, MRT_ARC_PEAK())

    let ga = sx_buf_get(rt, MRT_GC_ALLOCS())
    let gc_c = sx_buf_get(rt, MRT_GC_CYCLES())
    let gs = sx_buf_get(rt, MRT_GC_SWEPT())
    let gl = sx_buf_get(rt, MRT_GC_LIVE())
    let gpk = sx_buf_get(rt, MRT_GC_PEAK())
    let gr = sx_buf_get(rt, MRT_GC_RTOP())
    let ap = sx_buf_get(rt, MRT_ARENA_POS())
    let acap = sx_buf_get(rt, MRT_ARENA_CAP())
    let oom = sx_buf_get(rt, MRT_OOM_COUNT())

    if mode == MEM_MODE_EMBEDDED() {
        println("[Synchronix v3 Runtime] Embedded Static-Pool Memory Report:")
        print("  ARC Slab    : allocs="); print(aa)
        print(" retains="); print(ar)
        print(" releases="); print(al)
        print(" freed="); print(af)
        print(" live="); print(av)
        print(" peak="); print(apk); println("/64")

        print("  GC Slab     : allocs="); print(ga)
        print(" cycles="); print(gc_c)
        print(" swept="); print(gs)
        print(" live="); print(gl)
        print(" peak="); print(gpk); println("/64")

        print("  Bump Arena  : used="); print(ap * 8)
        print("B / "); print(acap * 8)
        print("B  oom_events="); println(oom)
        return 0
    }

    println("[Synchronix v3 Runtime] Hosted Unified Memory Report:")
    print("  ARC Engine  : allocs="); print(aa)
    print(" retains="); print(ar)
    print(" releases="); print(al)
    print(" freed="); print(af)
    print(" live="); print(av)
    print(" peak="); println(apk)

    print("  GC Engine   : allocs="); print(ga)
    print(" cycles="); print(gc_c)
    print(" swept="); print(gs)
    print(" live="); print(gl)
    print(" roots="); println(gr)

    print("  Arena Mgr   : used="); print(ap * 8)
    print(" bytes / "); print(acap * 8); println(" bytes")
    return 0
}

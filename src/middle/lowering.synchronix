// ============================================================================
// SYNCHRONIX v3.0.0 — Phase 2: Unified Lowering & Volatile-Safe Optimizations
// (src/middle/lowering.synchronix)
// ============================================================================
// Implements SUMIR -> Lowering -> Low-Level IR / Bare-Metal Targets:
//   1. SSA-Safe Constant Folding (single-def safety for loop-mutated vars)
//   2. Pure Leaf Function Inlining Analysis (respects ISR & volatile barriers)
//   3. Fixed-Point Dead Code Elimination (strictly preserves volatile MMIO,
//      IRQ critical sections, WFI, and DMB instructions!)
//   4. Embedded SUMIR & SRAM Budget Diagnostic Dumper (--dump-ir)
// ============================================================================

import sx_defs
import utils
import mem_safety
import phi_lambda_opt

phi lowering_fp_iters = 8 >= 4

func sx_fold_div(a: Int, b: Int) -> Int
    requires b != 0
{
    return a / b
}

func sx_fold_mod(a: Int, b: Int) -> Int
    requires b != 0
{
    return a % b
}

// ----------------------------------------------------------------------------
// Pass 1: SSA-Safe Constant Folding per Function
// ----------------------------------------------------------------------------
func sx_fold_fn(ctx: Int, fstart: Int, fend: Int) -> Int {
    let mv = MAX_VREGS()
    let is_c = sx_buf_new(mv)
    let cval = sx_buf_new(mv)
    let dcnt = sx_buf_new(mv)

    var k = fstart + 1
    while k < fend {
        let op0 = sx_ir_get(ctx, k, IR_OP())
        if op0 != IR_LABEL() && op0 != IR_JMP() && op0 != IR_BRZ() {
            let d0 = sx_ir_get(ctx, k, IR_DST())
            if d0 > 0 && d0 < mv {
                let prev = sx_buf_get(dcnt, d0)
                sx_buf_set(dcnt, d0, prev + 1)
            }
        }
        k = k + 1
    }

    var i = fstart + 1
    while i < fend {
        let fl = sx_ir_get(ctx, i, IR_FLAGS())
        let dead = fl && IRF_DEAD()
        if dead == 0 {
            let op = sx_ir_get(ctx, i, IR_OP())
            let dst = sx_ir_get(ctx, i, IR_DST())

            if op == IR_CONST() && dst > 0 && dst < mv {
                let dc = sx_buf_get(dcnt, dst)
                if dc == 1 {
                    let imm = sx_ir_get(ctx, i, IR_IMM())
                    sx_buf_set(is_c, dst, 1)
                    sx_buf_set(cval, dst, imm)
                }
            }

            if op == IR_MOV() && dst > 0 && dst < mv {
                let managed = (fl && IRF_ARC()) || (fl && IRF_GC()) || (fl && IRF_VOLATILE())
                let dc2 = sx_buf_get(dcnt, dst)
                let s1 = sx_ir_get(ctx, i, IR_SRC1())
                if managed == 0 && dc2 == 1 && s1 > 0 && s1 < mv {
                    let s1c = sx_buf_get(is_c, s1)
                    if s1c != 0 {
                        let cv = sx_buf_get(cval, s1)
                        sx_ir_set(ctx, i, IR_OP(), IR_CONST())
                        sx_ir_set(ctx, i, IR_IMM(), cv)
                        sx_buf_set(is_c, dst, 1)
                        sx_buf_set(cval, dst, cv)
                    }
                }
            }

            if op >= IR_ADD() && op <= IR_MOD() {
                let a_r = sx_ir_get(ctx, i, IR_SRC1())
                let b_r = sx_ir_get(ctx, i, IR_SRC2())
                if a_r > 0 && a_r < mv && b_r > 0 && b_r < mv {
                    let ca = sx_buf_get(is_c, a_r)
                    let cb = sx_buf_get(is_c, b_r)
                    if ca != 0 && cb != 0 {
                        let lv = sx_buf_get(cval, a_r)
                        let rv = sx_buf_get(cval, b_r)
                        var ok = 1
                        var res = 0
                        if op == IR_ADD() { res = lv + rv }
                        if op == IR_SUB() { res = lv - rv }
                        if op == IR_MUL() { res = lv * rv }
                        if op == IR_DIV() {
                            if rv == 0 { ok = 0 } else { res = sx_fold_div(lv, rv) }
                        }
                        if op == IR_MOD() {
                            if rv == 0 { ok = 0 } else { res = sx_fold_mod(lv, rv) }
                        }
                        if ok != 0 {
                            sx_ir_set(ctx, i, IR_OP(), IR_CONST())
                            sx_ir_set(ctx, i, IR_SRC1(), 0)
                            sx_ir_set(ctx, i, IR_SRC2(), 0)
                            sx_ir_set(ctx, i, IR_IMM(), res)
                            if dst > 0 && dst < mv {
                                let dc3 = sx_buf_get(dcnt, dst)
                                if dc3 == 1 {
                                    sx_buf_set(is_c, dst, 1)
                                    sx_buf_set(cval, dst, res)
                                }
                            }
                            sx_ctx_inc(ctx, CTX_STAT_CFOLD())
                        }
                    }
                }
            }
        }
        i = i + 1
    }

    sx_buf_free(is_c)
    sx_buf_free(cval)
    sx_buf_free(dcnt)
    return 0
}

func sx_pass_const_fold(ctx: Int) -> Int {
    let cnt = sx_ctx_get(ctx, CTX_IR_COUNT())
    var i = 0
    while i < cnt {
        let op = sx_ir_get(ctx, i, IR_OP())
        if op == IR_FUNC_BEGIN() {
            var j = i + 1
            var found = 0
            while j < cnt && found == 0 {
                let opj = sx_ir_get(ctx, j, IR_OP())
                if opj == IR_FUNC_END() {
                    found = 1
                } else {
                    j = j + 1
                }
            }
            sx_fold_fn(ctx, i, j)
            i = j
        }
        i = i + 1
    }
    return 0
}

// ----------------------------------------------------------------------------
// Pass 2: Small Pure Leaf Function Inlining Analysis (skips ISR handlers)
// ----------------------------------------------------------------------------
func sx_pass_inline(ctx: Int) -> Int {
    let cnt = sx_ctx_get(ctx, CTX_IR_COUNT())
    var i = 0
    while i < cnt {
        let op = sx_ir_get(ctx, i, IR_OP())
        if op == IR_FUNC_BEGIN() {
            let fn_fl = sx_ir_get(ctx, i, IR_FLAGS())
            let is_irq = fn_fl && IRF_IRQ()
            var j = i + 1
            var body_insts = 0
            var is_leaf = 1
            if is_irq != 0 { is_leaf = 0 }
            var done = 0
            while j < cnt && done == 0 {
                let opj = sx_ir_get(ctx, j, IR_OP())
                if opj == IR_FUNC_END() {
                    done = 1
                } else {
                    if opj == IR_CALL() || opj >= IR_MMIO_READ() {
                        is_leaf = 0
                    }
                    body_insts = body_insts + 1
                    j = j + 1
                }
            }
            if is_leaf != 0 && body_insts > 1 && body_insts <= 8 {
                let nfl = fn_fl || IRF_INLINED()
                sx_ir_set(ctx, i, IR_FLAGS(), nfl)
                sx_ctx_inc(ctx, CTX_STAT_INLINED())
            }
            i = j
        }
        i = i + 1
    }
    return 0
}

// ----------------------------------------------------------------------------
// Pass 3: Volatile-Safe Fixed-Point Dead Code Elimination (DCE)
// ----------------------------------------------------------------------------
func sx_is_pure_op(op: Int, fl: Int) -> Int {
    let is_vol = fl && IRF_VOLATILE()
    if is_vol != 0 { return 0 }
    if op >= IR_MMIO_READ() { return 0 }
    if op == IR_CONST() { return 1 }
    if op == IR_MOV() {
        let managed = (fl && IRF_ARC()) || (fl && IRF_GC())
        if managed == 0 { return 1 }
        return 0
    }
    if op >= IR_ADD() && op <= IR_NOT() { return 1 }
    return 0
}

func sx_dce_fn(ctx: Int, fstart: Int, fend: Int) -> Int {
    let mv = MAX_VREGS()
    let used = sx_buf_new(mv)

    var iter = 0
    while iter < 8 {
        var i = fend - 1
        while i > fstart {
            let fl = sx_ir_get(ctx, i, IR_FLAGS())
            let dead = fl && IRF_DEAD()
            if dead == 0 {
                let op = sx_ir_get(ctx, i, IR_OP())
                let pure = sx_is_pure_op(op, fl)
                var live = 1
                if pure != 0 {
                    let d = sx_ir_get(ctx, i, IR_DST())
                    if d > 0 && d < mv {
                        live = sx_buf_get(used, d)
                    } else {
                        live = 0
                    }
                }
                if live != 0 {
                    if op == IR_CLOSURE_SET() {
                        let cd = sx_ir_get(ctx, i, IR_DST())
                        if cd > 0 && cd < mv { sx_buf_set(used, cd, 1) }
                    }
                    let has1 = sx_op_has_src1_vreg(op)
                    if has1 != 0 {
                        let s1 = sx_ir_get(ctx, i, IR_SRC1())
                        if s1 > 0 && s1 < mv { sx_buf_set(used, s1, 1) }
                    }
                    if (op >= IR_ADD() && op <= IR_OR()) || op == IR_CLOSURE_CALL() || op == IR_MMIO_WRITE() {
                        let s2 = sx_ir_get(ctx, i, IR_SRC2())
                        if s2 > 0 && s2 < mv { sx_buf_set(used, s2, 1) }
                    }
                    if op == IR_SPAWN() {
                        let sp = sx_ir_get(ctx, i, IR_IMM())
                        if sp > 0 && sp < mv { sx_buf_set(used, sp, 1) }
                    }
                }
            }
            i = i - 1
        }
        iter = iter + 1
    }

    var j = fstart + 1
    while j < fend {
        let fl2 = sx_ir_get(ctx, j, IR_FLAGS())
        let dead2 = fl2 && IRF_DEAD()
        if dead2 == 0 {
            let op2 = sx_ir_get(ctx, j, IR_OP())
            let pure2 = sx_is_pure_op(op2, fl2)
            if pure2 != 0 {
                let d2 = sx_ir_get(ctx, j, IR_DST())
                if d2 > 0 && d2 < mv {
                    let is_u = sx_buf_get(used, d2)
                    if is_u == 0 {
                        sx_mark_ir_dead(ctx, j)
                        sx_ctx_inc(ctx, CTX_STAT_DCE())
                    }
                }
            }
        }
        j = j + 1
    }

    sx_buf_free(used)
    return 0
}

func sx_pass_dce(ctx: Int) -> Int {
    let cnt = sx_ctx_get(ctx, CTX_IR_COUNT())
    var i = 0
    while i < cnt {
        let op = sx_ir_get(ctx, i, IR_OP())
        if op == IR_FUNC_BEGIN() {
            var j = i + 1
            var found = 0
            while j < cnt && found == 0 {
                let opj = sx_ir_get(ctx, j, IR_OP())
                if opj == IR_FUNC_END() { found = 1 } else { j = j + 1 }
            }
            sx_dce_fn(ctx, i, j)
            i = j
        }
        i = i + 1
    }
    return 0
}

// ----------------------------------------------------------------------------
// Middle-End Pipeline Driver & Embedded SUMIR Diagnostic Dumper
// ----------------------------------------------------------------------------
func sx_dump_ir(ctx: Int) -> Int {
    let insts = sx_ctx_get(ctx, CTX_IR_COUNT())
    let cf = sx_ctx_get(ctx, CTX_STAT_CFOLD())
    let dce = sx_ctx_get(ctx, CTX_STAT_DCE())
    let arc_ops = sx_ctx_get(ctx, CTX_STAT_ARC_INS())
    let gc_r = sx_ctx_get(ctx, CTX_STAT_GC_ROOTS())
    let inl = sx_ctx_get(ctx, CTX_STAT_INLINED())
    let mmios = sx_ctx_get(ctx, CTX_STAT_MMIO())
    let sram = sx_ctx_get(ctx, CTX_STAT_SRAM_EST())

    print("[Phase 2: SUMIR/Lowering v3] insts=")
    print(insts)
    print(" const_folded=")
    print(cf)
    print(" dce_removed=")
    print(dce)
    print(" arc_ops=")
    print(arc_ops)
    print(" gc_roots=")
    print(gc_r)
    print(" inlined=")
    print(inl)
    print(" mmio=")
    print(mmios)
    print(" sram_est=")
    print(sram)
    println("B")
    return 0
}

func sx_middle_end_run(ctx: Int) -> Int {
    sx_pass_mem_safety(ctx)
    sx_pass_phi_lambda_opt(ctx)
    sx_pass_const_fold(ctx)
    sx_pass_inline(ctx)
    sx_pass_dce(ctx)

    let dump = sx_ctx_get(ctx, CTX_OPT_DUMP_IR())
    if dump != 0 {
        sx_dump_ir(ctx)
    }
    return 0
}

// ============================================================================
// SYNCHRONIX v3.0.0 — Ecosystem: Unified Formatter & Static Safety Linter
// (src/tooling/fmt_lint.synchronix)
// ============================================================================
// Pure Synchronix implementation of:
//   - sx_cmd_fmt(ctx, path)  : tokenizes & canonically formats .synchronix code
//   - sx_cmd_lint(ctx, path) : runs Phase 1 Sema + Phi & Embedded lint rules:
//       [PHI-001] unguarded division without a `requires` contract
//       [EMB-001] MMIO access in file without `noalloc` qualifier
//       [EMB-002] dynamic `gc()` detected alongside `irq` interrupt handlers
// ============================================================================

import sx_defs
import utils
import lexer
import parser
import sema

phi fmt_indent_spaces = 4 == 4

func sx_print_indent(level: Int) -> Int {
    var i = 0
    while i < level {
        print("    ")
        i = i + 1
    }
    return 0
}

func sx_cmd_fmt(ctx: Int, path: String) -> Int {
    sx_ctx_reset(ctx)
    let n = sx_read_source_file(ctx, path)
    if n < 0 {
        print("[Synchronix v3 fmt] Cannot open file: ")
        println(path)
        return 1
    }
    sx_lex(ctx)

    let cnt = sx_ctx_get(ctx, CTX_TOK_COUNT())
    var indent = 0
    var at_start = 1
    var prev_line = 1
    var i = 0
    var done = 0

    while i < cnt && done == 0 {
        let kind = sx_tok_get(ctx, i, TOK_KIND())
        if kind == TK_EOF() {
            done = 1
        } else {
            let line = sx_tok_get(ctx, i, TOK_LINE())
            let ts = sx_tok_get(ctx, i, TOK_START())
            let tl = sx_tok_get(ctx, i, TOK_LEN())

            if kind == TK_RBRACE() {
                if at_start == 0 { putchar(10) }
                if indent > 0 { indent = indent - 1 }
                sx_print_indent(indent)
                println("}")
                at_start = 1
                prev_line = line
            } else {
                if line > prev_line {
                    prev_line = line
                    if at_start == 0 {
                        putchar(10)
                        at_start = 1
                    }
                }
                if kind == TK_LBRACE() {
                    println(" {")
                    indent = indent + 1
                    at_start = 1
                } else {
                    if at_start != 0 {
                        sx_print_indent(indent)
                        at_start = 0
                    } else {
                        let no_sp = (kind == TK_RPAREN() || kind == TK_COMMA() || kind == TK_COLON() || kind == TK_SEMI() || kind == TK_LPAREN())
                        if no_sp == 0 {
                            putchar(32)
                        }
                    }
                    if kind == TK_STR() {
                        putchar(34)
                        sx_print_slice(ctx, ts, tl)
                        putchar(34)
                    } else {
                        sx_print_slice(ctx, ts, tl)
                    }
                }
            }
        }
        i = i + 1
    }

    if at_start == 0 {
        putchar(10)
    }
    return 0
}

func sx_cmd_lint(ctx: Int, path: String) -> Int {
    print("[Synchronix v3 Linter] Checking ")
    println(path)

    sx_ctx_reset(ctx)
    let n = sx_read_source_file(ctx, path)
    if n < 0 {
        print("[Synchronix v3 Linter] Cannot open file: ")
        println(path)
        return 1
    }
    sx_lex(ctx)
    let root = sx_parse_program(ctx)
    sx_sema_program(ctx, root)

    let cnt = sx_ctx_get(ctx, CTX_TOK_COUNT())
    var has_req = 0
    var has_noalloc = 0
    var has_irq = 0
    var has_mmio = 0
    var mmio_line = 0
    var gc_line = 0

    var i = 0
    while i < cnt {
        let k = sx_tok_get(ctx, i, TOK_KIND())
        if k == TK_KW_REQUIRES() { has_req = 1 }
        if k == TK_KW_NOALLOC()  { has_noalloc = 1 }
        if k == TK_KW_IRQ()      { has_irq = 1 }
        if k == TK_KW_MMIO_READ() || k == TK_KW_MMIO_WRITE() {
            has_mmio = 1
            if mmio_line == 0 { mmio_line = sx_tok_get(ctx, i, TOK_LINE()) }
        }
        if k == TK_KW_GC() && gc_line == 0 {
            gc_line = sx_tok_get(ctx, i, TOK_LINE())
        }
        i = i + 1
    }

    if has_req == 0 {
        var j = 0
        while j < cnt {
            let k2 = sx_tok_get(ctx, j, TOK_KIND())
            if k2 == TK_SLASH() {
                let ln = sx_tok_get(ctx, j, TOK_LINE())
                sx_warn(ctx, ln, "Lint [PHI-001]: division operator detected - consider adding a requires denom != 0 Phi contract")
            }
            j = j + 1
        }
    }

    if has_mmio != 0 && has_noalloc == 0 {
        sx_warn(ctx, mmio_line, "Lint [EMB-001]: MMIO hardware access detected - consider marking driver functions `noalloc`")
    }
    if has_irq != 0 && gc_line > 0 {
        sx_warn(ctx, gc_line, "Lint [EMB-002]: tracing GC allocation used in module with IRQ handlers - ensure static pool pause bounds meet ISR latency")
    }

    let errs = sx_ctx_get(ctx, CTX_ERR_COUNT())
    let warns = sx_ctx_get(ctx, CTX_WARN_COUNT())
    print("[Synchronix v3 Linter] Done: ")
    print(errs)
    print(" error(s), ")
    print(warns)
    println(" warning(s).")
    return errs
}

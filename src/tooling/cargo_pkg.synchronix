// ============================================================================
// SYNCHRONIX v3.0.0 — Ecosystem: Unified Cargo Package & Firmware CLI
// (src/tooling/cargo_pkg.synchronix)
// ============================================================================
// Unified V2 Main + V2 Embedded Package Manager:
//   - sx_cmd_new(name, embedded) : scaffolds hosted package OR embedded MCU
//                                  firmware package (w/ Cortex-M4 memory.ld)
//   - sx_cmd_build(ctx, src, out): verifies Synchronix.toml & builds binary/ELF
//   - sx_cmd_run(ctx, src)       : builds & executes native / host-sim binary
//   - sx_cmd_test(ctx, src)      : compiles, verifies Phi proofs & runs tests
//   - sx_cmd_size(path)          : inspects Flash/RAM section sizes via llvm-size
// ============================================================================

import sx_defs
import portable_asm
import utils
import emitter

extern func fputs(s: Int, fp: Int) -> Int;
extern func system(cmd: Int) -> Int;
extern func sx_print_str(s: Int) -> Int;
extern func sx_println_str(s: Int) -> Int;

phi cargo_edition_year = 2026 >= 2026

func sx_write_manifest(fp: Int, proj_name: Int, is_emb: Int) -> Int {
    fputs("[package]\nname = ", fp)
    fputc(34, fp); fputs(proj_name, fp); fputc(34, fp)
    fputs("\nversion = ", fp)
    fputc(34, fp); fputs("0.3.0", fp); fputc(34, fp)
    fputs("\nedition = ", fp)
    fputc(34, fp); fputs("2026", fp); fputc(34, fp)
    fputs("\ncompiler = ", fp)
    fputc(34, fp); fputs("synchronix-v3-unified", fp); fputc(34, fp)

    if is_emb != 0 {
        fputs("\n\n[embedded]\ntarget = ", fp)
        fputc(34, fp); fputs("cortex-m4", fp); fputc(34, fp)
        fputs("\nmemory_model = ", fp)
        fputc(34, fp); fputs("static-pool-arc-gc", fp); fputc(34, fp)
        fputs("\nflash_kb = 256\nsram_kb = 64\nnoalloc_isr = true\nlinker_script = ", fp)
        fputc(34, fp); fputs("memory.ld", fp); fputc(34, fp)
        fputs("\n\n[dependencies]\nstd = ", fp)
        fputc(34, fp); fputs("3.0", fp); fputc(34, fp)
    } else {
        fputs("\nmemory_model = ", fp)
        fputc(34, fp); fputs("unified-arc-gc", fp); fputc(34, fp)
        fputs("\n\n[dependencies]\nstd = ", fp)
        fputc(34, fp); fputs("3.0", fp); fputc(34, fp)
    }
    fputc(10, fp)
    return 0
}

func sx_write_linker_script(fp: Int) -> Int {
    fputs("/* Synchronix v3.0.0 Cortex-M4 Linker Script */\n", fp)
    fputs("ENTRY(Reset_Handler)\n", fp)
    fputs("MEMORY\n{\n", fp)
    fputs("    FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 256K\n", fp)
    fputs("    SRAM  (rwx) : ORIGIN = 0x20000000, LENGTH = 64K\n", fp)
    fputs("}\n", fp)
    fputs("_estack = ORIGIN(SRAM) + LENGTH(SRAM);\n", fp)
    fputs("SECTIONS\n{\n", fp)
    fputs("    .isr_vector : { KEEP(*(.isr_vector)) } > FLASH\n", fp)
    fputs("    .text : { *(.text*) *(.rodata*) } > FLASH\n", fp)
    fputs("    .data : { *(.data*) } > SRAM AT > FLASH\n", fp)
    fputs("    .bss  : { *(.bss*) } > SRAM\n", fp)
    fputs("}\n", fp)
    return 0
}

func sx_write_starter_main_hosted(fp: Int) -> Int {
    fputs("// Synchronix v3.0.0 Project - Generated by `synchronix new`\n", fp)
    fputs("func main() -> Int {\n", fp)
    fputs("    let msg = ", fp)
    fputc(34, fp)
    fputs("Hello from Synchronix v3 (100% Pure Synchronix Unified Hosted + Embedded)!", fp)
    fputc(34, fp)
    fputs("\n    println(msg)\n", fp)
    fputs("    let box = arc(42)\n", fp)
    fputs("    val managed = gc(100)\n", fp)
    fputs("    prove 2 + 2 == 4\n", fp)
    fputs("    println(box + managed)\n", fp)
    fputs("    mem_stats()\n", fp)
    fputs("    return 0\n", fp)
    fputs("}\n", fp)
    return 0
}

func sx_write_starter_main_emb(fp: Int) -> Int {
    fputs("// Synchronix v3.0.0 Firmware - Generated by `synchronix new --embedded`\n", fp)
    fputs("phi uart_aligned = (0x4000_C000 % 4) == 0\n\n", fp)
    fputs("irq noalloc func systick_isr() -> Int {\n", fp)
    fputs("    let pin = mmio_read(0x4002_0010)\n", fp)
    fputs("    mmio_write(0x4002_0014, pin)\n", fp)
    fputs("    dmb()\n", fp)
    fputs("    return pin\n", fp)
    fputs("}\n\n", fp)
    fputs("func main() -> Int {\n", fp)
    fputs("    irq_disable()\n", fp)
    fputs("    mmio_write(0x4000_C000, 79)\n", fp)
    fputs("    mmio_write(0x4000_C000, 75)\n", fp)
    fputs("    mmio_write(0x4000_C000, 10)\n", fp)
    fputs("    irq_enable()\n", fp)
    fputs("    let box = arc(42)\n", fp)
    fputs("    val managed = gc(100)\n", fp)
    fputs("    prove 2 + 2 == 4\n", fp)
    fputs("    println(box + managed)\n", fp)
    fputs("    wfi()\n", fp)
    fputs("    return 0\n", fp)
    fputs("}\n", fp)
    return 0
}

func sx_cmd_new(proj_name: Int, is_emb: Int) -> Int {
    let dir_src = sx_cstr_alloc(512)
    let p_toml = sx_cstr_alloc(512)
    let p_ld = sx_cstr_alloc(512)
    let p_main = sx_cstr_alloc(512)

    sx_os_mkdir(proj_name)
    sx_cstr_copy(dir_src, proj_name)
    sx_cstr_cat(dir_src, "/src")
    sx_os_mkdir(dir_src)

    sx_cstr_copy(p_toml, proj_name); sx_cstr_cat(p_toml, "/Synchronix.toml")
    let f_toml = fopen(p_toml, "w")
    if f_toml == 0 {
        println("[Synchronix v3 Cargo] Error: cannot create Synchronix.toml")
        sx_cstr_free(dir_src); sx_cstr_free(p_toml); sx_cstr_free(p_ld); sx_cstr_free(p_main)
        return 1
    }
    sx_write_manifest(f_toml, proj_name, is_emb)
    fclose(f_toml)

    if is_emb != 0 {
        sx_cstr_copy(p_ld, proj_name); sx_cstr_cat(p_ld, "/memory.ld")
        let f_ld = fopen(p_ld, "w")
        if f_ld != 0 {
            sx_write_linker_script(f_ld)
            fclose(f_ld)
        }
    }

    sx_cstr_copy(p_main, proj_name); sx_cstr_cat(p_main, "/src/main.synchronix")
    let f_main = fopen(p_main, "w")
    if f_main == 0 {
        println("[Synchronix v3 Cargo] Error: cannot create src/main.synchronix")
        sx_cstr_free(dir_src); sx_cstr_free(p_toml); sx_cstr_free(p_ld); sx_cstr_free(p_main)
        return 1
    }
    if is_emb != 0 {
        sx_write_starter_main_emb(f_main)
    } else {
        sx_write_starter_main_hosted(f_main)
    }
    fclose(f_main)

    if is_emb != 0 {
        print("[Synchronix v3 Cargo] Created embedded firmware package '")
        sx_print_str(proj_name)
        println("' (Synchronix.toml + memory.ld + src/main.synchronix)")
    } else {
        print("[Synchronix v3 Cargo] Created package '")
        sx_print_str(proj_name)
        println("' (Synchronix.toml + src/main.synchronix)")
    }

    sx_cstr_free(dir_src); sx_cstr_free(p_toml); sx_cstr_free(p_ld); sx_cstr_free(p_main)
    return 0
}

func sx_cmd_size(bin_path: Int) -> Int {
    if sx_file_exists(bin_path) == 0 {
        print("[Synchronix v3 Size] File not found: ")
        sx_println_str(bin_path)
        return 1
    }
    let cmd = sx_cstr_alloc(1024)
    sx_cstr_copy(cmd, "llvm-size ")
    sx_cstr_cat_quoted(cmd, bin_path)
    let rc = system(cmd)
    sx_cstr_free(cmd)
    return rc
}

func sx_cmd_build(ctx: Int, src_in: Int, out_in: Int) -> Int {
    var src_path = src_in
    var out_path = out_in

    if src_path == 0 {
        if sx_file_exists("Synchronix.toml") == 0 {
            println("[Synchronix v3 Cargo] Error: Synchronix.toml not found in current directory.")
            return 1
        }
        src_path = "src/main.synchronix"
    }
    if out_path == 0 {
        out_path = "synchronix_app.exe"
    }

    let rc = sx_compile_file(ctx, src_path, out_path)
    if rc == 0 {
        print("[Synchronix v3 Cargo] Build succeeded -> ")
        sx_println_str(out_path)
    }
    return rc
}

func sx_cmd_run(ctx: Int, src_in: Int) -> Int {
    let brc = sx_cmd_build(ctx, src_in, "synchronix_app.exe")
    if brc != 0 {
        return brc
    }
    println("[Synchronix v3 Cargo] Running synchronix_app.exe...")
    let cmd = sx_cstr_alloc(512)
    sx_cstr_cat_quoted(cmd, "synchronix_app.exe")
    let rc = system(cmd)
    sx_cstr_free(cmd)
    return rc
}

func sx_cmd_test(ctx: Int, src_in: Int) -> Int {
    let rc = sx_cmd_run(ctx, src_in)
    if rc == 0 {
        println("[Synchronix v3 Cargo] All Phi proofs, noalloc checks & runtime tests PASSED!")
    }
    return rc
}

// ============================================================================
// SYNCHRONIX v3.0.0 — Phase 1: Unified Semantic Analyzer & Safety Verifier
// (src/frontend/sema.synchronix)
// ============================================================================
// Full V2-parity Semantic Analyzer + Embedded Static Safety Guarantees:
//   - Lexical Scope Stack, Type Inference & Generics Resolution
//   - Phi Formal Logic Static Constant Evaluator & Theorem Prover
//   - Lambda Free-Variable Capture Scanner & Registry
//   - Embedded `noalloc` / `irq` Enforcer (zero allocation in ISRs/noalloc fns)
//   - Embedded `irq` Non-Blocking Check (forbids `await` inside ISR handlers)
//   - Embedded MMIO Alignment & Null-Address Static Phi Proof Verifier
// ============================================================================

import sx_defs
import utils

phi sema_phi_states_ordered = 1 < 3
phi sema_mmio_word_align    = 4 == 4

// ----------------------------------------------------------------------------
// Scoped Symbol Table Operations
// ----------------------------------------------------------------------------
func sx_scope_push(ctx: Int) -> Int {
    let d = sx_ctx_get(ctx, CTX_SCOPE_DEPTH())
    sx_ctx_set(ctx, CTX_SCOPE_DEPTH(), d + 1)
    return d + 1
}

func sx_scope_pop(ctx: Int) -> Int {
    let depth = sx_ctx_get(ctx, CTX_SCOPE_DEPTH())
    var cnt = sx_ctx_get(ctx, CTX_SYM_COUNT())
    let syms = sx_ctx_get(ctx, CTX_SYMBOLS())
    var keep = 1

    while cnt > 0 && keep != 0 {
        let base = (cnt - 1) * SYME_STRIDE()
        let sd = sx_buf_get(syms, base + SYME_SCOPE())
        if sd >= depth {
            cnt = cnt - 1
        } else {
            keep = 0
        }
    }
    sx_ctx_set(ctx, CTX_SYM_COUNT(), cnt)
    sx_ctx_set(ctx, CTX_SCOPE_DEPTH(), depth - 1)
    return depth - 1
}

func sx_sym_add(ctx: Int, nstart: Int, nlen: Int, ty: Int) -> Int {
    let cnt = sx_ctx_get(ctx, CTX_SYM_COUNT())
    let lim = MAX_SYMBOLS()
    if cnt >= lim {
        return -1
    }
    sx_ctx_set(ctx, CTX_SYM_COUNT(), cnt + 1)
    let syms = sx_ctx_get(ctx, CTX_SYMBOLS())
    let base = cnt * SYME_STRIDE()
    let depth = sx_ctx_get(ctx, CTX_SCOPE_DEPTH())

    sx_buf_set(syms, base + SYME_NAME_START(), nstart)
    sx_buf_set(syms, base + SYME_NAME_LEN(), nlen)
    sx_buf_set(syms, base + SYME_TYPE(), ty)
    sx_buf_set(syms, base + SYME_SCOPE(), depth)
    sx_buf_set(syms, base + SYME_OWN_STATE(), OWN_OWNED())

    var mk = MEM_STACK()
    if ty == TY_ARC() { mk = MEM_ARC() }
    if ty == TY_GC() { mk = MEM_GC() }
    if ty == TY_CLOSURE() { mk = MEM_CLOSURE() }
    sx_buf_set(syms, base + SYME_MEM_KIND(), mk)
    sx_buf_set(syms, base + SYME_SLOT(), 0)
    sx_buf_set(syms, base + SYME_CONST_VAL(), 0)
    return cnt
}

func sx_sym_lookup(ctx: Int, nstart: Int, nlen: Int) -> Int {
    var i = sx_ctx_get(ctx, CTX_SYM_COUNT()) - 1
    let syms = sx_ctx_get(ctx, CTX_SYMBOLS())
    while i >= 0 {
        let base = i * SYME_STRIDE()
        let el = sx_buf_get(syms, base + SYME_NAME_LEN())
        if el == nlen {
            let es = sx_buf_get(syms, base + SYME_NAME_START())
            let eq = sx_src_eq_slice(ctx, nstart, nlen, es)
            if eq != 0 {
                return i
            }
        }
        i = i - 1
    }
    return -1
}

// ----------------------------------------------------------------------------
// Phi Static Formal Evaluator (Compile-Time Constant & Theorem Prover)
// ----------------------------------------------------------------------------
func sx_safe_static_div(lhs: Int, rhs: Int) -> Int
    requires rhs != 0
{
    return lhs / rhs
}

func sx_safe_static_mod(lhs: Int, rhs: Int) -> Int
    requires rhs != 0
{
    return lhs % rhs
}

func sx_phi_eval_binop(op: Int, lhs: Int, rhs: Int, out_box: Int) -> Int {
    if op == TK_PLUS()    { sx_buf_set(out_box, 0, lhs + rhs); return 1 }
    if op == TK_MINUS()   { sx_buf_set(out_box, 0, lhs - rhs); return 1 }
    if op == TK_STAR()    { sx_buf_set(out_box, 0, lhs * rhs); return 1 }
    if op == TK_SLASH() {
        if rhs == 0 { return 0 }
        let q = sx_safe_static_div(lhs, rhs)
        sx_buf_set(out_box, 0, q)
        return 1
    }
    if op == TK_PERCENT() {
        if rhs == 0 { return 0 }
        let m = sx_safe_static_mod(lhs, rhs)
        sx_buf_set(out_box, 0, m)
        return 1
    }
    if op == TK_EQ() { sx_buf_set(out_box, 0, lhs == rhs); return 1 }
    if op == TK_NE() { sx_buf_set(out_box, 0, lhs != rhs); return 1 }
    if op == TK_LT() { sx_buf_set(out_box, 0, lhs < rhs); return 1 }
    if op == TK_LE() { sx_buf_set(out_box, 0, lhs <= rhs); return 1 }
    if op == TK_GT() { sx_buf_set(out_box, 0, lhs > rhs); return 1 }
    if op == TK_GE() { sx_buf_set(out_box, 0, lhs >= rhs); return 1 }
    return 0
}

func sx_phi_eval_const(ctx: Int, expr: Int, out_box: Int) -> Int {
    if expr <= 0 {
        return 0
    }
    let kind = sx_ast_get(ctx, expr, AST_KIND())
    if kind == NK_INT() {
        let iv = sx_ast_get(ctx, expr, AST_IVAL())
        sx_buf_set(out_box, 0, iv)
        return 1
    }
    if kind == NK_BINOP() {
        let lbox = sx_buf_new(2)
        let rbox = sx_buf_new(2)
        let left_n = sx_ast_get(ctx, expr, AST_LEFT())
        let ok_l = sx_phi_eval_const(ctx, left_n, lbox)
        var res = 0
        if ok_l != 0 {
            let right_n = sx_ast_get(ctx, expr, AST_RIGHT())
            let ok_r = sx_phi_eval_const(ctx, right_n, rbox)
            if ok_r != 0 {
                let lv = sx_buf_get(lbox, 0)
                let rv = sx_buf_get(rbox, 0)
                let op = sx_ast_get(ctx, expr, AST_IVAL())
                res = sx_phi_eval_binop(op, lv, rv, out_box)
            }
        }
        sx_buf_free(lbox)
        sx_buf_free(rbox)
        return res
    }
    if kind == NK_UNOP() {
        let ubox = sx_buf_new(2)
        let opd = sx_ast_get(ctx, expr, AST_LEFT())
        let ok_u = sx_phi_eval_const(ctx, opd, ubox)
        var ures = 0
        if ok_u != 0 {
            let uv = sx_buf_get(ubox, 0)
            let uop = sx_ast_get(ctx, expr, AST_IVAL())
            if uop == TK_MINUS() {
                sx_buf_set(out_box, 0, -uv)
                ures = 1
            } else {
                if uv == 0 {
                    sx_buf_set(out_box, 0, 1)
                } else {
                    sx_buf_set(out_box, 0, 0)
                }
                ures = 1
            }
        }
        sx_buf_free(ubox)
        return ures
    }
    return 0
}

// ----------------------------------------------------------------------------
// Embedded Static Safety Checks: noalloc / irq / MMIO Alignment
// ----------------------------------------------------------------------------
func sx_is_noalloc_active(ctx: Int) -> Int {
    let global_na = sx_ctx_get(ctx, CTX_OPT_NOALLOC())
    if global_na != 0 {
        return 1
    }
    let fn_fl = sx_ctx_get(ctx, CTX_CUR_FN_FLAGS())
    let local_na = fn_fl && FL_NOALLOC()
    if local_na != 0 {
        return 1
    }
    return 0
}

func sx_verify_mmio_addr(ctx: Int, addr_expr: Int, line: Int) -> Int {
    let abox = sx_buf_new(2)
    let is_c = sx_phi_eval_const(ctx, addr_expr, abox)
    if is_c != 0 {
        let addr = sx_buf_get(abox, 0)
        if addr == 0 {
            sx_error(ctx, line, "Embedded Phi Error: null MMIO register address (0x0)")
        } else {
            let rem = addr % 4
            if rem != 0 {
                sx_error(ctx, line, "Embedded Phi Error: unaligned 32-bit MMIO register address")
            } else {
                sx_ctx_inc(ctx, CTX_STAT_PHI_STAT())
            }
        }
    }
    sx_buf_free(abox)
    sx_ctx_inc(ctx, CTX_STAT_MMIO())
    return 0
}

// ----------------------------------------------------------------------------
// Lambda (Functional Logic) Capture Scanner
// ----------------------------------------------------------------------------
func sx_lambda_scan_cap(ctx: Int, expr: Int, lam_id: Int) -> Int {
    if expr <= 0 {
        return 0
    }
    let kind = sx_ast_get(ctx, expr, AST_KIND())
    let lams = sx_ctx_get(ctx, CTX_LAMBDAS())
    let lbase = lam_id * 8

    if kind == NK_IDENT() {
        let ns = sx_ast_get(ctx, expr, AST_NAME_START())
        let nl = sx_ast_get(ctx, expr, AST_NAME_LEN())
        let ps = sx_buf_get(lams, lbase + 4)
        let pl = sx_buf_get(lams, lbase + 5)
        var is_param = 0
        if nl == pl {
            is_param = sx_src_eq_slice(ctx, ns, nl, ps)
        }
        if is_param == 0 {
            sx_buf_set(lams, lbase + 1, ns)
            sx_buf_set(lams, lbase + 2, nl)
        }
        return 0
    }

    let lch = sx_ast_get(ctx, expr, AST_LEFT())
    let rch = sx_ast_get(ctx, expr, AST_RIGHT())
    sx_lambda_scan_cap(ctx, lch, lam_id)
    sx_lambda_scan_cap(ctx, rch, lam_id)
    return 0
}

// ----------------------------------------------------------------------------
// Expression Type Inference & Semantic Checker
// ----------------------------------------------------------------------------
func sx_sema_lambda(ctx: Int, expr: Int) -> Int {
    if sx_is_noalloc_active(ctx) != 0 {
        let line = sx_ast_get(ctx, expr, AST_LINE())
        sx_error(ctx, line, "Embedded Safety Error: closure allocation forbidden in noalloc/irq function")
    }
    let lid = sx_ctx_inc(ctx, CTX_LAMBDA_COUNT())
    sx_ast_set(ctx, expr, AST_META(), lid)

    let lams = sx_ctx_get(ctx, CTX_LAMBDAS())
    let lbase = lid * 8
    let ps = sx_ast_get(ctx, expr, AST_NAME_START())
    let pl = sx_ast_get(ctx, expr, AST_NAME_LEN())
    sx_buf_set(lams, lbase + 0, expr)
    sx_buf_set(lams, lbase + 1, 0)
    sx_buf_set(lams, lbase + 2, 0)
    sx_buf_set(lams, lbase + 3, 0)
    sx_buf_set(lams, lbase + 4, ps)
    sx_buf_set(lams, lbase + 5, pl)
    sx_buf_set(lams, lbase + 6, lid)

    let body = sx_ast_get(ctx, expr, AST_RIGHT())
    sx_lambda_scan_cap(ctx, body, lid)

    sx_scope_push(ctx)
    sx_sym_add(ctx, ps, pl, TY_INT())
    sx_sema_expr(ctx, body)
    sx_scope_pop(ctx)

    sx_ast_set(ctx, expr, AST_TYPE(), TY_CLOSURE())
    return TY_CLOSURE()
}

func sx_sema_emb_expr(ctx: Int, expr: Int, kind: Int) -> Int {
    let line = sx_ast_get(ctx, expr, AST_LINE())
    if kind == NK_MMIO_READ() {
        let addr = sx_ast_get(ctx, expr, AST_LEFT())
        sx_sema_expr(ctx, addr)
        sx_verify_mmio_addr(ctx, addr, line)
        sx_ast_set(ctx, expr, AST_TYPE(), TY_INT())
        return TY_INT()
    }
    if kind == NK_MMIO_WRITE() {
        let addr2 = sx_ast_get(ctx, expr, AST_LEFT())
        let val2 = sx_ast_get(ctx, expr, AST_RIGHT())
        sx_sema_expr(ctx, addr2)
        sx_sema_expr(ctx, val2)
        sx_verify_mmio_addr(ctx, addr2, line)
        sx_ast_set(ctx, expr, AST_TYPE(), TY_INT())
        return TY_INT()
    }
    sx_ctx_inc(ctx, CTX_STAT_IRQ_OPS())
    sx_ast_set(ctx, expr, AST_TYPE(), TY_INT())
    return TY_INT()
}

func sx_sema_expr(ctx: Int, expr: Int) -> Int {
    if expr <= 0 {
        return TY_VOID()
    }
    let kind = sx_ast_get(ctx, expr, AST_KIND())

    if kind == NK_INT() {
        let ety = sx_ast_get(ctx, expr, AST_TYPE())
        if ety == TY_UNKNOWN() {
            sx_ast_set(ctx, expr, AST_TYPE(), TY_INT())
            return TY_INT()
        }
        return ety
    }
    if kind == NK_STR() {
        sx_ast_set(ctx, expr, AST_TYPE(), TY_STR())
        return TY_STR()
    }
    if kind == NK_IDENT() {
        let ns = sx_ast_get(ctx, expr, AST_NAME_START())
        let nl = sx_ast_get(ctx, expr, AST_NAME_LEN())
        let sidx = sx_sym_lookup(ctx, ns, nl)
        if sidx < 0 {
            let line = sx_ast_get(ctx, expr, AST_LINE())
            sx_error(ctx, line, "Semantic Error: undefined identifier")
            sx_ast_set(ctx, expr, AST_TYPE(), TY_INT())
            return TY_INT()
        }
        let syms = sx_ctx_get(ctx, CTX_SYMBOLS())
        let sty = sx_buf_get(syms, sidx * SYME_STRIDE() + SYME_TYPE())
        sx_ast_set(ctx, expr, AST_TYPE(), sty)
        return sty
    }
    if kind == NK_BINOP() {
        let lnode = sx_ast_get(ctx, expr, AST_LEFT())
        let rnode = sx_ast_get(ctx, expr, AST_RIGHT())
        sx_sema_expr(ctx, lnode)
        sx_sema_expr(ctx, rnode)
        let op = sx_ast_get(ctx, expr, AST_IVAL())
        if op == TK_SLASH() {
            let dbox = sx_buf_new(2)
            let is_c = sx_phi_eval_const(ctx, rnode, dbox)
            if is_c != 0 {
                let dv = sx_buf_get(dbox, 0)
                if dv == 0 {
                    let dline = sx_ast_get(ctx, expr, AST_LINE())
                    sx_error(ctx, dline, "Phi Formal Verification FAILED: provable division by zero")
                }
            }
            sx_buf_free(dbox)
        }
        sx_ast_set(ctx, expr, AST_TYPE(), TY_INT())
        return TY_INT()
    }
    if kind == NK_UNOP() {
        let un_l = sx_ast_get(ctx, expr, AST_LEFT())
        sx_sema_expr(ctx, un_l)
        sx_ast_set(ctx, expr, AST_TYPE(), TY_INT())
        return TY_INT()
    }
    if kind == NK_ARC_NEW() {
        if sx_is_noalloc_active(ctx) != 0 {
            let aline = sx_ast_get(ctx, expr, AST_LINE())
            sx_error(ctx, aline, "Embedded Safety Error: arc() allocation forbidden in noalloc/irq function")
        }
        let al = sx_ast_get(ctx, expr, AST_LEFT())
        sx_sema_expr(ctx, al)
        sx_ast_set(ctx, expr, AST_TYPE(), TY_ARC())
        return TY_ARC()
    }
    if kind == NK_GC_NEW() {
        if sx_is_noalloc_active(ctx) != 0 {
            let gline = sx_ast_get(ctx, expr, AST_LINE())
            sx_error(ctx, gline, "Embedded Safety Error: gc() allocation forbidden in noalloc/irq function")
        }
        let gl = sx_ast_get(ctx, expr, AST_LEFT())
        sx_sema_expr(ctx, gl)
        sx_ast_set(ctx, expr, AST_TYPE(), TY_GC())
        return TY_GC()
    }
    if kind == NK_BORROW() {
        let bl = sx_ast_get(ctx, expr, AST_LEFT())
        sx_sema_expr(ctx, bl)
        sx_ast_set(ctx, expr, AST_TYPE(), TY_BORROW())
        return TY_BORROW()
    }
    if kind == NK_MOVE() {
        let ml = sx_ast_get(ctx, expr, AST_LEFT())
        let mt = sx_sema_expr(ctx, ml)
        sx_ast_set(ctx, expr, AST_TYPE(), mt)
        return mt
    }
    if kind == NK_LAMBDA() {
        let lt = sx_sema_lambda(ctx, expr)
        return lt
    }
    if kind == NK_SPAWN() {
        let sl = sx_ast_get(ctx, expr, AST_LEFT())
        sx_sema_expr(ctx, sl)
        sx_ast_set(ctx, expr, AST_TYPE(), TY_TASK())
        return TY_TASK()
    }
    if kind == NK_AWAIT() {
        let fn_fl = sx_ctx_get(ctx, CTX_CUR_FN_FLAGS())
        let in_irq = fn_fl && FL_IRQ()
        if in_irq != 0 {
            let awline = sx_ast_get(ctx, expr, AST_LINE())
            sx_error(ctx, awline, "Embedded Safety Error: blocking await forbidden inside irq handler")
        }
        let awl = sx_ast_get(ctx, expr, AST_LEFT())
        sx_sema_expr(ctx, awl)
        sx_ast_set(ctx, expr, AST_TYPE(), TY_INT())
        return TY_INT()
    }
    if kind >= NK_MMIO_READ() && kind <= NK_DMB() {
        let et = sx_sema_emb_expr(ctx, expr, kind)
        return et
    }
    if kind == NK_CALL() {
        var arg = sx_ast_get(ctx, expr, AST_RIGHT())
        while arg != 0 {
            sx_sema_expr(ctx, arg)
            arg = sx_ast_get(ctx, arg, AST_NEXT())
        }
        let gty = sx_ast_get(ctx, expr, AST_EXTRA2())
        var cty = TY_INT()
        if gty != TY_UNKNOWN() {
            cty = gty
        }
        sx_ast_set(ctx, expr, AST_TYPE(), cty)
        return cty
    }
    return TY_VOID()
}

// ----------------------------------------------------------------------------
// Phi Formal Verification & Statement Semantic Checker
// ----------------------------------------------------------------------------
func sx_verify_phi_node(ctx: Int, prop: Int, owner: Int) -> Int {
    if prop <= 0 {
        return 0
    }
    sx_sema_expr(ctx, prop)
    let pbox = sx_buf_new(2)
    let is_c = sx_phi_eval_const(ctx, prop, pbox)
    if is_c != 0 {
        let pval = sx_buf_get(pbox, 0)
        if pval != 0 {
            sx_ast_set(ctx, owner, AST_META(), PHI_PROVEN_STATIC())
            sx_ctx_inc(ctx, CTX_STAT_PHI_STAT())
        } else {
            sx_ast_set(ctx, owner, AST_META(), PHI_REFUTED())
            let line = sx_ast_get(ctx, owner, AST_LINE())
            sx_error(ctx, line, "Phi Formal Verification FAILED: proposition statically refuted")
        }
    } else {
        sx_ast_set(ctx, owner, AST_META(), PHI_RUNTIME_CHECK())
        sx_ctx_inc(ctx, CTX_STAT_PHI_RT())
    }
    sx_buf_free(pbox)
    return 0
}

func sx_sema_stmt(ctx: Int, stmt: Int) -> Int {
    if stmt <= 0 {
        return 0
    }
    let kind = sx_ast_get(ctx, stmt, AST_KIND())

    if kind == NK_BLOCK() {
        sx_scope_push(ctx)
        var cur = sx_ast_get(ctx, stmt, AST_LEFT())
        while cur != 0 {
            sx_sema_stmt(ctx, cur)
            cur = sx_ast_get(ctx, cur, AST_NEXT())
        }
        sx_scope_pop(ctx)
        return 0
    }
    if kind == NK_LET() {
        let rhs = sx_ast_get(ctx, stmt, AST_LEFT())
        let rty = sx_sema_expr(ctx, rhs)
        let decl_ty = sx_ast_get(ctx, stmt, AST_TYPE())
        var final_ty = rty
        if decl_ty != TY_UNKNOWN() {
            if rty != TY_ARC() && rty != TY_GC() && rty != TY_CLOSURE() {
                final_ty = decl_ty
            }
        }
        sx_ast_set(ctx, stmt, AST_TYPE(), final_ty)
        let ns = sx_ast_get(ctx, stmt, AST_NAME_START())
        let nl = sx_ast_get(ctx, stmt, AST_NAME_LEN())
        sx_sym_add(ctx, ns, nl, final_ty)
        return 0
    }
    if kind == NK_ASSIGN() || kind == NK_RETURN() || kind == NK_EXPR_STMT() {
        let e = sx_ast_get(ctx, stmt, AST_LEFT())
        sx_sema_expr(ctx, e)
        return 0
    }
    if kind == NK_IF() {
        let cond = sx_ast_get(ctx, stmt, AST_LEFT())
        let thn = sx_ast_get(ctx, stmt, AST_RIGHT())
        let els = sx_ast_get(ctx, stmt, AST_EXTRA())
        sx_sema_expr(ctx, cond)
        sx_sema_stmt(ctx, thn)
        sx_sema_stmt(ctx, els)
        return 0
    }
    if kind == NK_WHILE() {
        let wcond = sx_ast_get(ctx, stmt, AST_LEFT())
        let wbody = sx_ast_get(ctx, stmt, AST_RIGHT())
        sx_sema_expr(ctx, wcond)
        sx_sema_stmt(ctx, wbody)
        return 0
    }
    if kind == NK_PROVE() {
        let pe = sx_ast_get(ctx, stmt, AST_LEFT())
        sx_verify_phi_node(ctx, pe, stmt)
        return 0
    }
    return 0
}

func sx_dump_ast(ctx: Int) -> Int {
    let nodes = sx_ctx_get(ctx, CTX_AST_COUNT())
    let pstat = sx_ctx_get(ctx, CTX_STAT_PHI_STAT())
    let prt = sx_ctx_get(ctx, CTX_STAT_PHI_RT())
    let lams = sx_ctx_get(ctx, CTX_LAMBDA_COUNT())
    let mmios = sx_ctx_get(ctx, CTX_STAT_MMIO())
    let nafns = sx_ctx_get(ctx, CTX_STAT_NOALLOC_FN())
    print("[Phase 1: Typed AST v3] nodes=")
    print(nodes)
    print(" phi_static=")
    print(pstat)
    print(" phi_runtime=")
    print(prt)
    print(" lambdas=")
    print(lams)
    print(" mmio_ops=")
    print(mmios)
    print(" noalloc_fns=")
    println(nafns)
    return 0
}

func sx_sema_program(ctx: Int, root: Int) -> Int {
    var decl = sx_ast_get(ctx, root, AST_LEFT())
    while decl != 0 {
        let dkind = sx_ast_get(ctx, decl, AST_KIND())
        if dkind == NK_PHI_DECL() {
            let pprop = sx_ast_get(ctx, decl, AST_LEFT())
            sx_verify_phi_node(ctx, pprop, decl)
        }
        if dkind == NK_FUNC() {
            let fflags = sx_ast_get(ctx, decl, AST_IVAL())
            sx_ctx_set(ctx, CTX_CUR_FN_FLAGS(), fflags)
            if (fflags && FL_NOALLOC()) != 0 {
                sx_ctx_inc(ctx, CTX_STAT_NOALLOC_FN())
            }
            sx_scope_push(ctx)
            var param = sx_ast_get(ctx, decl, AST_LEFT())
            while param != 0 {
                let ps = sx_ast_get(ctx, param, AST_NAME_START())
                let pl = sx_ast_get(ctx, param, AST_NAME_LEN())
                let pt = sx_ast_get(ctx, param, AST_TYPE())
                sx_sym_add(ctx, ps, pl, pt)
                param = sx_ast_get(ctx, param, AST_NEXT())
            }
            let req = sx_ast_get(ctx, decl, AST_EXTRA())
            if req != 0 {
                sx_verify_phi_node(ctx, req, decl)
            }
            let body = sx_ast_get(ctx, decl, AST_RIGHT())
            sx_sema_stmt(ctx, body)
            sx_scope_pop(ctx)
            sx_ctx_set(ctx, CTX_CUR_FN_FLAGS(), 0)
        }
        decl = sx_ast_get(ctx, decl, AST_NEXT())
    }

    let dump = sx_ctx_get(ctx, CTX_OPT_DUMP_AST())
    if dump != 0 {
        sx_dump_ast(ctx)
    }
    let errs = sx_ctx_get(ctx, CTX_ERR_COUNT())
    return errs
}

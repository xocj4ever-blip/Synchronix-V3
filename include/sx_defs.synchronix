// ============================================================================
// SYNCHRONIX v3.0.0 — Unified Shared Compiler, IR, HAL & Runtime Definitions
// (include/sx_defs.synchronix)
// ============================================================================
// 100% Pure Synchronix Unified Hosted + Embedded Parity across all 5 domains:
//   Phase 1: Frontend (Lexer w/ hex & embedded kws, Parser, Sema + noalloc/MMIO)
//   Phase 2: Middle-End (SUMIR + MMIO/IRQ/WFI/DMB, Ownership/ARC/GC, Lowering)
//   Phase 3: Backend (x86_64, ARM64, ARM64-bare, Cortex-M4, x86_64-bare, LLVM)
//   Foundation: Dual-Mode Unified Memory (Hosted + Static-Pool), M:N/RTOS
//               Fibers, Phi/Lambda Runtime, Full Core + Embedded DSP Stdlib
//   Ecosystem: Cargo Hosted & Firmware Scaffold, Size/Budget, LSP, Linter, Prof
// ============================================================================

// Top-level Phi Formal Axioms — statically verified at compile time (0 cost)
phi sx_v3_version_major      = 3 == 3
phi sx_v3_tok_stride_valid   = 6 == 6
phi sx_v3_ast_stride_valid   = 12 == 12
phi sx_v3_sym_stride_valid   = 8 == 8
phi sx_v3_ir_stride_valid    = 8 == 8
phi sx_v3_obj_hdr_aligned    = (6 * 8) == 48
phi sx_v3_host_arena_bytes   = (8192 * 8) == 65536
phi sx_v3_emb_pool_bounded   = (64 * 48) == 3072
phi sx_v3_emb_arena_bounded  = (512 * 8) == 4096
phi sx_v3_task_stride_valid  = 6 == 6

